    "check:content": "node scripts/check-content.mjs",
    "check:editorial": "node scripts/check-editorial-boundaries.mjs",
    "check:archive": "node scripts/check-archive-boundaries.mjs",
    "check:archive-recovery": "node scripts/check-legacy-recovery-boundaries.mjs",
    "check:release-decisions": "node scripts/check-release-decision-packet.mjs",
    "check:github": "node scripts/check-github-archive.mjs",
    "check:github-sync": "node scripts/check-github-content-sync.mjs",
    "sync:github": "node scripts/sync-github-content.mjs",
    "check:jolene-contract": "node scripts/check-jolene-contract.mjs",
    "check:jolene-job-fit": "node scripts/check-jolene-job-fit.mjs",
