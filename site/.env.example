# Set this to the approved production origin before publishing. On Vercel, the
# project production URL is used automatically when this explicit value is absent.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Disabled by default. Development mode uses only an in-memory on-page verifier.
NEXT_PUBLIC_PORTFOLIO_ANALYTICS_MODE=disabled

# Keep disabled for the first public portfolio release. Fixture mode never calls a live service.
NEXT_PUBLIC_JOLENE_MODE=disabled
NEXT_PUBLIC_JOLENE_FIXTURE_SCENARIO=success

# Disabled-by-default Sentry exception telemetry. The browser DSN is public by
# design; all other credentials remain server-only and out of source control.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=replace-with-exact-git-sha
SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-with-exact-git-sha

# CI-only private source-map upload. Enabling this fails closed unless every
# required value exists. Use an org token limited to release/CI operations.
SENTRY_RELEASE_UPLOAD_ENABLED=false
SENTRY_AUTH_TOKEN=replace-with-ci-only-org-token
SENTRY_ORG=replace-with-sentry-org-slug
SENTRY_PROJECT=replace-with-sentry-project-slug

# Disabled-by-default signed Sentry service-hook intake. The Asana task itself
# is the durable issue-id and delivery-fingerprint ledger; raw events are never stored.
SENTRY_ASANA_INTAKE_ENABLED=false
SENTRY_SERVICE_HOOK_SECRET=replace-with-server-only-hook-secret
ASANA_ACCESS_TOKEN=replace-with-server-only-least-privilege-token
ASANA_WORKSPACE_ID=9789386902387
ASANA_PORTFOLIO_PROJECT_ID=1216473233375594
ASANA_IN_PROGRESS_SECTION_ID=1216473233375596
SENTRY_ASANA_TIMEOUT_MS=8000

# Disabled-by-default safety net for missed Sentry service-hook deliveries.
# The route follows Vercel's CRON_SECRET convention, but no production schedule
# is committed until Carl approves its recurring invocation cost.
SENTRY_ASANA_RECONCILIATION_ENABLED=false
CRON_SECRET=replace-with-server-only-random-secret
SENTRY_API_TOKEN=replace-with-read-only-issues-token
SENTRY_RECONCILIATION_ENVIRONMENT=production
SENTRY_RECONCILIATION_LIMIT=25
SENTRY_RECONCILIATION_TIMEOUT_MS=8000

# Server-only public Jolene BFF configuration. Keep disabled until the live-service,
# distributed-control, monitoring, and release gates are explicitly approved.
JOLENE_PUBLIC_BFF_ENABLED=false
JOLENE_PUBLIC_MANIFEST_ENABLED=false
JOLENE_PUBLIC_ANSWER_ENABLED=false
JOLENE_PUBLIC_JOB_FIT_ENABLED=false
JOLENE_PUBLIC_CONTACT_INTENT_ENABLED=false
JOLENE_PUBLIC_API_ORIGIN=https://public-jolene.example
JOLENE_PUBLIC_API_TOKEN=replace-with-server-only-secret
# Local contract testing only. Permits an unauthenticated http://127.0.0.1 upstream; never set in production.
JOLENE_PUBLIC_ALLOW_LOOPBACK=false
JOLENE_PUBLIC_EXPECTED_CORPUS_VERSION=career:replace-with-reviewed-corpus-hash
JOLENE_BFF_CLIENT_HASH_SALT=replace-with-server-only-random-salt

# Optional authenticated runtime control document. Its response can only disable
# environment-enabled features and fails closed when unavailable or malformed.
JOLENE_BFF_CONTROL_URL=https://control.example/public-jolene
JOLENE_BFF_CONTROL_TOKEN=replace-with-server-only-control-secret

# Conservative per-instance defaults. Distributed edge enforcement is still
# required before a multi-instance live release.
JOLENE_BFF_TIMEOUT_MS=12000
JOLENE_BFF_RATE_WINDOW_MS=60000
JOLENE_BFF_RATE_REQUESTS=12
JOLENE_BFF_DAILY_COST_UNITS=1000
JOLENE_BFF_CONCURRENCY=4
JOLENE_BFF_TRACKED_CLIENTS=10000
