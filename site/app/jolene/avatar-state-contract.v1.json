{
  "schemaVersion": "2.0.0",
  "contractName": "jolene.avatar-state",
  "initialState": "idle",
  "fallbackState": "idle",
  "states": ["idle", "blink", "greet", "excited", "listen", "think", "speak", "evidence", "boundary", "offline", "rest"],
  "definitions": {
    "idle": { "frames": ["idle-0"], "durationsMs": [1000], "loop": true, "returnState": null, "reducedMotionFrame": "idle-0" },
    "blink": { "frames": ["blink-0"], "durationsMs": [120], "loop": false, "returnState": "idle", "reducedMotionFrame": "idle-0" },
    "greet": { "frames": ["greet-0"], "durationsMs": [700], "loop": false, "returnState": "idle", "reducedMotionFrame": "greet-0" },
    "excited": { "frames": ["excited-0"], "durationsMs": [1000], "loop": true, "returnState": null, "reducedMotionFrame": "excited-0" },
    "listen": { "frames": ["listen-0", "listen-1", "listen-2"], "durationsMs": [460, 220, 460], "loop": true, "returnState": null, "reducedMotionFrame": "listen-0" },
    "think": { "frames": ["think-dance-a", "think-dance-b"], "durationsMs": [230, 230], "loop": true, "returnState": null, "reducedMotionFrame": "think-dance-a" },
    "speak": { "frames": ["speak-0", "speak-1", "speak-2"], "durationsMs": [360, 90, 360], "loop": true, "returnState": null, "reducedMotionFrame": "speak-0" },
    "evidence": { "frames": ["evidence-0", "evidence-1", "evidence-2", "evidence-3"], "durationsMs": [160, 180, 300, 360], "loop": false, "returnState": "idle", "reducedMotionFrame": "evidence-0" },
    "boundary": { "frames": ["boundary-0", "boundary-1", "boundary-2"], "durationsMs": [420, 260, 420], "loop": true, "returnState": null, "reducedMotionFrame": "boundary-0" },
    "offline": { "frames": ["offline-0", "offline-1", "offline-2"], "durationsMs": [520, 300, 520], "loop": true, "returnState": null, "reducedMotionFrame": "offline-0" },
    "rest": { "frames": ["rest-0"], "durationsMs": [1000], "loop": true, "returnState": null, "reducedMotionFrame": "rest-0" }
  },
  "transitions": {
    "idle": ["blink", "greet", "excited", "listen", "think", "speak", "evidence", "boundary", "offline", "rest"],
    "blink": ["idle", "greet", "excited", "listen", "think", "speak", "evidence", "boundary", "offline", "rest"],
    "greet": ["idle", "blink", "excited", "listen", "think", "speak", "evidence", "boundary", "offline", "rest"],
    "excited": ["idle", "blink", "greet", "listen", "think", "speak", "evidence", "boundary", "offline", "rest"],
    "listen": ["idle", "blink", "greet", "excited", "think", "speak", "evidence", "boundary", "offline", "rest"],
    "think": ["idle", "blink", "greet", "excited", "listen", "speak", "evidence", "boundary", "offline", "rest"],
    "speak": ["idle", "blink", "greet", "excited", "listen", "think", "evidence", "boundary", "offline", "rest"],
    "evidence": ["idle", "blink", "greet", "excited", "listen", "think", "speak", "boundary", "offline", "rest"],
    "boundary": ["idle", "blink", "greet", "excited", "listen", "think", "speak", "evidence", "offline", "rest"],
    "offline": ["idle", "blink", "greet", "excited", "listen", "think", "speak", "evidence", "boundary", "rest"],
    "rest": ["idle", "blink", "greet", "excited", "listen", "think", "speak", "evidence", "boundary", "offline"]
  },
  "signals": {
    "intro_started": "greet",
    "chat_opened": "greet",
    "visitor_typing": "excited",
    "visitor_input": "listen",
    "request_started": "think",
    "answer_started": "speak",
    "answer_finished": "idle",
    "evidence_highlighted": "evidence",
    "cannot_verify": "boundary",
    "service_unavailable": "offline",
    "inactive": "rest",
    "activity_resumed": "idle"
  },
  "interruption": {
    "alwaysInterruptFor": ["offline"],
    "settleBeforeTransition": ["blink", "greet", "evidence"],
    "maximumSettleMs": 1000
  },
  "rendering": {
    "sheetPath": "/jolene/v1-static-sheet/jolene-v1-static-sheet.png",
    "fallbackPath": "/jolene/v1-static-sheet/idle-fallback.png",
    "frameCatalogPath": "/app/jolene/avatar-frame-catalog.v1.json",
