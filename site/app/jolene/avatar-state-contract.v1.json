    "frameWidth": 105,
    "frameHeight": 115,
    "columns": 22,
    "staticFallbackFrame": "idle-0",
    "imageSmoothing": false,
    "aspectRatioLocked": true
  },
  "blink": {
    "onlyWhileState": "idle",
    "minimumIntervalMs": 4000,
    "maximumIntervalMs": 7000,
    "durationMs": 120
  },
  "inactivity": { "restAfterMs": 20000 },
  "reducedMotion": {
    "animate": false,
    "useStateRepresentativeFrame": true,
    "unsolicitedIntroState": "idle"
  },
  "providerIndependent": true
