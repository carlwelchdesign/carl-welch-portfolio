{
  "name": "carl-welch-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "next build --webpack",
    "preview:lan": "vinext build && node scripts/stage-lan-preview.mjs && HOST=0.0.0.0 PORT=4173 NODE_ENV=production node .vinext-preview/server.js",
    "build:sentry": "SENTRY_RELEASE_UPLOAD_ENABLED=true vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext-preview",
    "check:metadata": "node scripts/check-metadata.mjs",
    "generate:social-cards": "node scripts/generate-project-share-cards.mjs",
    "check:social-card-integrity": "node scripts/check-social-card-integrity.mjs",
    "check:social-cards": "node scripts/generate-project-share-cards.mjs --check",
    "check:content": "node scripts/check-content.mjs",
    "check:no-em-dashes": "node scripts/check-no-em-dashes.mjs",
    "check:editorial": "node scripts/check-editorial-boundaries.mjs",
    "check:archive": "node scripts/check-archive-boundaries.mjs",
    "check:legacy-visuals": "node scripts/check-legacy-career-visuals.mjs",
    "check:archive-recovery": "node scripts/check-legacy-recovery-boundaries.mjs",
    "check:release-decisions": "node scripts/check-release-decision-packet.mjs",
    "check:github": "node scripts/check-github-archive.mjs",
    "check:github-sync": "node scripts/check-github-content-sync.mjs",
    "sync:github": "node scripts/sync-github-content.mjs",
    "check:jolene-contract": "node scripts/check-jolene-contract.mjs",
    "check:jolene-job-fit": "node scripts/check-jolene-job-fit.mjs",
    "check:jolene-bff": "node scripts/check-jolene-bff.mjs",
    "check:jolene-live": "JOLENE_LIVE_CONTRACT_ORIGIN=http://127.0.0.1:8431 node scripts/check-jolene-bff.mjs",
    "check:jolene-browser-live": "node scripts/check-jolene-browser-live.mjs",
    "check:jolene-avatar-brief": "node scripts/check-jolene-avatar-brief.mjs",
    "build:jolene-avatar-master": "node scripts/build-jolene-avatar-master.mjs",
    "check:jolene-avatar-master": "node scripts/build-jolene-avatar-master.mjs --check",
    "build:jolene-avatar-identity-lock": "node scripts/build-jolene-avatar-identity-lock.mjs",
    "check:jolene-avatar-identity-lock": "node scripts/build-jolene-avatar-identity-lock.mjs --check",
    "check:jolene-avatar-state": "node scripts/check-jolene-avatar-state-contract.mjs",
    "build:jolene-avatar-sprites": "node scripts/build-jolene-avatar-sprites.mjs",
    "check:jolene-avatar-sprites": "node scripts/build-jolene-avatar-sprites.mjs --check",
    "build:jolene-avatar-review": "node scripts/build-jolene-avatar-review.mjs",
    "check:jolene-avatar-review": "node scripts/build-jolene-avatar-review.mjs --check",
    "check:jolene-avatar-renderer": "node scripts/check-jolene-avatar-renderer.mjs",
    "check:jolene-avatar-faces": "node scripts/check-jolene-avatar-face-consistency.mjs",
    "build:jolene-approved-runtime": "node scripts/stage-jolene-approved-runtime-assets.mjs",
    "check:jolene-approved-runtime": "node scripts/stage-jolene-approved-runtime-assets.mjs --check",
    "build:jolene-greet-review": "node scripts/build-jolene-greet-v2-review.mjs",
    "check:jolene-greet-review": "node scripts/build-jolene-greet-v2-review.mjs --check",
    "evaluate:jolene": "node scripts/evaluate-public-jolene.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:sentry-privacy": "node scripts/check-sentry-privacy.mjs",
    "check:sentry-asana": "node scripts/check-sentry-asana-intake.mjs",
    "check:sentry-reconciliation": "node scripts/check-sentry-reconciliation.mjs",
    "check:sentry-release": "node scripts/check-sentry-release-config.mjs",
    "check:sentry-operations": "node scripts/check-sentry-operations.mjs",
    "check:research-protocol": "node scripts/check-research-protocol.mjs",
    "check:recovery": "node scripts/check-recovery-boundaries.mjs",
    "check:repository-security": "node scripts/check-repository-security.mjs",
    "check:repository-layout": "node scripts/check-repository-layout.mjs",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:no-public-sourcemaps": "node scripts/check-no-public-sourcemaps.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "check:container": "node scripts/check-container.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "node scripts/check-production-origin.mjs",
    "check:browser": "playwright test",
    "check:jolene-ui:disabled": "JOLENE_UI_CONTACT_ENABLED=false playwright test --config=playwright.jolene.config.ts",
    "check:jolene-ui:enabled": "JOLENE_UI_CONTACT_ENABLED=true playwright test --config=playwright.jolene.config.ts",
    "check:jolene-ui:error": "JOLENE_UI_CONTACT_ENABLED=false JOLENE_UI_SCENARIO=unavailable playwright test --config=playwright.jolene.config.ts",
    "check:jolene-ui": "pnpm check:jolene-ui:disabled && pnpm check:jolene-ui:enabled && pnpm check:jolene-ui:error",
    "check": "pnpm check:repository-layout && pnpm typecheck && pnpm lint && pnpm check:metadata && pnpm check:social-card-integrity && pnpm check:social-cards && pnpm check:content && pnpm check:no-em-dashes && pnpm check:editorial && pnpm check:archive && pnpm check:legacy-visuals && pnpm check:archive-recovery && pnpm check:release-decisions && pnpm check:github-sync && pnpm check:jolene-contract && pnpm check:jolene-job-fit && pnpm check:jolene-bff && pnpm check:jolene-avatar-brief && pnpm check:jolene-avatar-master && pnpm check:jolene-avatar-identity-lock && pnpm check:jolene-avatar-state && pnpm check:jolene-avatar-sprites && pnpm check:jolene-avatar-review && pnpm check:jolene-avatar-renderer && pnpm check:jolene-avatar-faces && pnpm check:jolene-greet-review && pnpm check:jolene-approved-runtime && pnpm check:analytics && pnpm check:sentry-privacy && pnpm check:sentry-asana && pnpm check:sentry-reconciliation && pnpm check:sentry-release && pnpm check:sentry-operations && pnpm check:research-protocol && pnpm check:recovery && pnpm check:security-headers && pnpm check:release-readiness && pnpm build && pnpm check:no-public-sourcemaps"
  },
  "dependencies": {
    "@vercel/analytics": "^1.1.0",
    "@sentry/browser": "10.73.0",
    "@sentry/cloudflare": "10.73.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "motion": "13.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "1.62.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
